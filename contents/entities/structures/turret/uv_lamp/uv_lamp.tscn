[sub_resource type="Shader" id=5]
code = "shader_type canvas_item;
render_mode blend_add;

uniform float wave_speed = 1.0;
uniform float wave_strenght = 0.1;
uniform sampler2D tex_frg_4;
uniform sampler2D TextureUniform;

void fragment() {
	vec3 noise_uv = vec3(UV, 0.0) + vec3(TIME * wave_speed);
	vec4 noise = texture(tex_frg_4, noise_uv.xy);
	float offset = dot(noise.rgb, vec3(0.333333, 0.333333, 0.333333)) * wave_strenght - wave_strenght * 0.5;
	vec2 final_uv = UV + vec2(offset, offset);
	vec4 tex = texture(TextureUniform, final_uv);
	COLOR.rgb = MODULATE.rgb * tex.rgb;
	COLOR.a = tex.a * MODULATE.a;
}
"

